{
  "info": {
    "name": "TP3 Calculatrice REST",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "addition",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8081/CalculatriceREST/api/calcul/addition?a=10&b=5"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut HTTP 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Reponse JSON correcte\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "    const resultat = pm.response.json();",
              "    pm.expect(resultat.a).to.eql(10);",
              "    pm.expect(resultat.b).to.eql(5);",
              "    pm.expect(resultat.op).to.eql(\"+\");",
              "    pm.expect(resultat.res).to.eql(15);",
              "});"
            ]
          }
        }
      ]
    },
